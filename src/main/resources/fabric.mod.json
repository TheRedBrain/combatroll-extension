{
	"schemaVersion": 1,
	"id": "combatrollextension",
	"version": "${version}",
	"name": "Combat Roll Extension",
	"description": "Extends the mod 'Combat Roll' with additional functionality.",
	"authors": [
		"TheRedBrain"
	],
	"contact": {
		"sources": "https://github.com/TheRedBrain/combatroll-extension"
	},

	"license": "MIT",
	"icon": "assets/combatrollextension/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.github.theredbrain.combatrollextension.CombatRollExtension"
		],
		"client": [
			"com.github.theredbrain.combatrollextension.CombatRollExtensionClient"
		]
	},
	"mixins": [
		"combatrollextension.mixins.json"
	],
	"custom": {
		"fzzy_config": [
			"combatrollextension"
		]
	},
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "${minecraft_version}",
		"fabric-api": "*",
		"fzzy_config": ">=${fzzy_config_version}",
		"combatroll": ">=${combat_roll_version}",
		"staminaattributes": ">=${stamina_attributes_version}"
	}
}